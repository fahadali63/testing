# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- WhatsApp ---
# Comma-separated group names to watch (case-insensitive, partial match). Empty = all groups.
WATCH_GROUPS=BSCS 5th,DSA,OOP Section B
# Where alerts/digests go: international number without "+". Empty = your own "Message yourself" chat.
NOTIFY_NUMBER=

# --- Schedule ---
TIMEZONE=Asia/Karachi
# Daily digest time (cron syntax, in TIMEZONE). "0 7 * * *" = 7:00 AM daily. "0 21 * * *" = 9 PM.
DIGEST_CRON=0 7 * * *
DIGEST_DAYS_AHEAD=7
# Send a WhatsApp alert as soon as a new/changed item is detected
INSTANT_ALERTS=true
# Analyze every image/PDF posted in watched groups (not just ones with keyword captions)
ANALYZE_ALL_MEDIA=false

# --- Claude ---
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# --- Google Calendar (optional) ---
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=./credentials.json
